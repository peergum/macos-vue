{
  "name": "@peergum/macos-react",
  "version": "3.0.0",
  "license": "GPL-3.0-or-later",
  "author": "Phil Hilger <phil@peergum.com> (https://github.com/peergum)",
  "description": "A React-based Mac OS simulation with modern features and improved performance",
  "homepage": "https://macos.peergum.com",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peergum/macos-vue.git"
  },
  "bugs": {
    "url": "https://github.com/peergum/macos-vue/issues"
  },
  "keywords": [
    "mac os",
    "react",
    "react.js",
    "components",
    "ux",
    "ui",
    "simulation",
    "emulation",
    "design",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/macos-react.umd.cjs",
  "module": "./dist/macos-react.esm.js",
  "types": "./dist/macos-react.d.ts",
  "exports": {
    ".": {
      "import": "./dist/macos-react.es.js",
      "require": "./dist/macos-react.umd.cjs"
    },
    "./*": "./*",
    "./dist/style.css": "./dist/style.css"
  },
  "exclude": [
    "src/App.tsx",
    "src/main.tsx"
  ],
  "scripts": {
    "dev": "genversion -e src/version.js && vite",
    "tsc": "tsc --noEmit && vite build",
    "build": "genversion -e src/version.js && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@heroicons/react": "^2.1.3",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/typography": "github:tailwindcss/typography",
    "ansi-to-html": "^0.7.2",
    "autoprefixer": "^10.4.17",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.10",
    "pdfjs-dist": "^3.11.174",
    "postcss": "^8.4.34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.12.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^1.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "genversion": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vite": "^5.2.8",
    "vitest": "^1.4.0"
  }
}
